root = true

# 全项目统一 UTF-8（无 BOM）+ LF，杜绝 GBK/ANSI 造成的乱码与解析错误
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.go]
indent_style = tab

# Windows 脚本必须 CRLF
[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
